# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock        # 可选：应用项目通常提交，此处先忽略便于多端；发布前可改为提交
.metadata

# 由 flutter create 生成的各平台目录（我们只保留定制过的部分）
# 注意：android/ windows/ 目录需要保留定制，故不整体忽略，仅忽略构建产物

# IDE
.idea/
.vscode/
*.iml

# 本地工具链（Flutter SDK / Android SDK / JDK，勿入库）
.tooling/
.diag/

# 本地数据与备份
*.db
*.db-journal
*.sqlite
backups/

# 同步服务端落盘数据：含账号与同步密钥明文，绝不入库
server/data/

# 排障期的一次性产物：探针脚本 + 恢复前的库/密钥备份（同样是明文口令）
# 明确写死，避免任何人 git add -A 把 secret 推进历史
_sync_probe/
_sync_recovery_backup/

# 系统
Thumbs.db
.DS_Store
